# Local development against `docker compose up -d` (run from the repo root)
DATABASE_URL=postgres://hostel:hostel@localhost:5432/hostel_booking
DB_SSL=false
REDIS_URL=redis://localhost:6379
JWT_SECRET=change_me
JWT_EXPIRY=1d
PORT=5000

# Comma separated list of frontend origins allowed by CORS (leave empty to allow any origin)
CORS_ORIGIN=http://localhost:5173

# set to "production" to hide stack traces in error responses
NODE_ENV=development
